    uint16_t reserved0;
    char     operator_id[16];         // 선택
    uint8_t  reserved[60];
} StopParamsV1;                       // 80 bytes

typedef struct {
    uint16_t alarm_code_le;
    uint16_t reserved0;
    uint32_t occurrence_id_le;
