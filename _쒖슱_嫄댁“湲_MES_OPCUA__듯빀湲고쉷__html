} StartParamsV1;                      // 80 bytes

typedef struct {
    uint16_t reason_code_le;
    uint16_t comment_code_le;
    uint8_t  reserved[76];
} PauseParamsV1;                      // 80 bytes

typedef struct {
    uint32_t run_id_le;
    uint32_t recipe_id_le;
    uint32_t recipe_version_le;
    uint32_t recipe_crc32_le;
    uint8_t  reserved[64];
} ResumeParamsV1;                     // 80 bytes

typedef struct {
